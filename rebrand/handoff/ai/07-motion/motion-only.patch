@@ -0,0 +1,63 @@
+import { useEffect, type RefObject } from 'react';
+
+import { prefersReducedMotion } from './reducedMotion';
+
+/** Partner logos marquee speed — home.js:127: 28 px per second. */
+export const MARQUEE_PX_PER_S = 28;
+
+/**
+ * `PS.PartnerLogos` strip (Perasure `shared/ps-ui/home.js:117-131`, M-068):
+ * the track holds its content twice and runs left by one copy's length L
+ * (Σ logo width + 24 px gap) at 28 px/s, linear, forever, on its own WAAPI
+ * (compositor) animation started once — not a Motion `animate` prop, whose
+ * re-renders restarted it (owner: "the partner logos often don't move").
+ * Not started with reduced motion (the strip stands still).
+ *
+ * L is measured as half the track's width (two identical copies), again when
+ * the track resizes (fonts, images, rotation); the loop keeps its place.
+ */
+export function useMarquee(trackRef: RefObject<HTMLElement | null>) {
+  useEffect(() => {
+    const el = trackRef.current;
+    if (!el || typeof el.animate !== 'function' || prefersReducedMotion()) {
+      return undefined;
+    }
+
+    let animation: Animation | null = null;
+    let length = 0;
+
+    const start = () => {
+      const next = el.scrollWidth / 2;
+      if (!(next > 0) || Math.abs(next - length) < 0.5) return;
+      const duration = (next / MARQUEE_PX_PER_S) * 1000;
+      let progress = 0;
+      if (animation) {
+        const time = Number(animation.currentTime ?? 0);
+        const previous = (length / MARQUEE_PX_PER_S) * 1000;
+        progress = previous > 0 ? (time % previous) / previous : 0;
+        animation.cancel();
+      }
+      length = next;
+      animation = el.animate(
+        [
+          { transform: 'translateX(0px)' },
+          { transform: `translateX(${-next}px)` },
+        ],
+        { duration, iterations: Infinity, easing: 'linear' },
+      );
+      animation.currentTime = progress * duration;
+    };
+
+    start();
+    const observer =
+      typeof ResizeObserver === 'function' ? new ResizeObserver(start) : null;
+    observer?.observe(el);
+    window.addEventListener('resize', start);
+
+    return () => {
+      observer?.disconnect();
+      window.removeEventListener('resize', start);
+      animation?.cancel();
+    };
+  }, [trackRef]);
+}
diff --git a/src/motion/useScrimAttributes.ts b/src/motion/useScrimAttributes.ts
new file mode 100644
index 0000000..84359ff
--- /dev/null
+++ b/src/motion/useScrimAttributes.ts
@@ -0,0 +1,49 @@
+import { useLayoutEffect, type RefObject } from 'react';
+
+type Attributes = Record<string, string | undefined>;
+
+function apply(el: Element, attrs: Attributes) {
+  for (const [name, value] of Object.entries(attrs)) {
+    if (value === undefined) el.removeAttribute(name);
+    else el.setAttribute(name, value);
+  }
+}
+
+/**
+ * Puts attributes on the scrim (and optionally the panel) of the shared
+ * {@link Sheet} this panel is in. The scrim is the first child of the Sheet
+ * layer, the panel's sibling.
+ *
+ * Production sheets tracked taps through `data-event-type` on their own mask
+ * and panel (the global click collector reads `dataset.eventType`), and some
+ * labelled the mask. Sheet draws both itself and takes no data-* props, so
+ * the migrated sheets hand those attributes over here and keep the tracking
+ * contract. Runs after the Sheet commits its frame (child effects run first),
+ * before paint.
+ *
+ * 共享 Sheet 自己绘制遮罩与面板；迁移后的弹层用它把原遮罩／面板上的埋点
+ * data-event-type、aria-label 挂回去，保持点击采集不变。
+ */
+export function useScrimAttributes(
+  panelRef: RefObject<HTMLElement | null>,
+  open: boolean,
+  scrimAttributes: Attributes,
+  panelAttributes: Attributes = {},
+): void {
+  const key = JSON.stringify([scrimAttributes, panelAttributes]);
+  useLayoutEffect(() => {
+    if (!open) return;
+    const panel = panelRef.current;
+    const layer = panel?.parentElement;
+    if (!panel || !layer || !layer.hasAttribute('data-sheet-layer')) return;
+    const [scrimAttrs, panelAttrs] = JSON.parse(key) as [
+      Attributes,
+      Attributes,
+    ];
+    const scrim = layer.firstElementChild;
+    if (scrim && scrim !== panel) apply(scrim, scrimAttrs);
+    apply(panel, panelAttrs);
+  }, [panelRef, open, key]);
+}
+
+export default useScrimAttributes;
