+export function stretchSpring(
+  travelPx: number,
+  base: PhysicalSpring = MT.SPRING,
+): PhysicalSpring {
+  const s = Math.min(2.5, Math.max(1, Math.abs(travelPx) / 378));
+  if (s === 1) return base;
