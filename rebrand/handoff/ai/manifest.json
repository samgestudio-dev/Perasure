{
 "package": "PeraSure rebrand — visual + motion hand-off for phi_h5_025",
 "readFirst": "README.md",
 "baseline": {
  "repo": "git.kuainiujinke.com:business_delivery_ph/phi_h5_025",
  "branch": "master",
  "commit": "0d9bdd4",
  "date": "2026-11-23"
 },
 "design": {
  "figmaFile": "kYyNV2MgxvH1w9bJ46A3yx",
  "demoRepo": "samgestudio-dev/Perasure",
  "demoBranch": "tokens/rebrand-v3",
  "tokensVersion": "2026.11.23"
 },
 "written": "2026-11-24, revised 2026-11-25",
 "scope": "purely visual: colour, typeface, type sizes/weights/tracking, radius, shadow, blur, spacing/position, icons, illustrations, animation colours. No structure, props, behaviour, flow or logic. Exceptions, owner-approved 2026-11-24 (structural: \"owner-approved\"): E023 + E542 tab icon as masked <span> with currentColor; E543 + E400 data-overdue on the Home payment button.",
 "applyOrder": [
  {
   "step": 1,
   "what": "visual: steps 0-7 of the edit list + the step-5 asset files + prettier (fmt)",
   "command": "python3 \"$H/tools/apply.py\" \"$REPO\" --step all",
   "then": "0 anchor-missing; rm \"$REPO/rebrand-apply-report.json\"; commit A (git add -A && git commit -m \"style(rebrand): apply the visual hand-off (tokens, edits, assets)\")"
  },
  {
   "step": 2,
   "what": "motion: install, then the patch",
   "command": "cd \"$REPO\" && npm install motion@14.4.0 --save-exact && git apply --check \"$H/07-motion/motion.patch\" && git apply \"$H/07-motion/motion.patch\"",
   "then": "commit B (git add -A && git commit -m \"feat(motion): add the rebrand motion (motion@14.4.0)\")"
  },
  {
   "step": 3,
   "what": "step 8 (last): drop var() fallbacks of defined tokens, 02-changes/step8-tests.json, prettier, legacy-blue check",
   "command": "python3 \"$H/tools/apply.py\" \"$REPO\" --step 8",
   "then": "\"no legacy blue literal left in src/\"; rm \"$REPO/rebrand-apply-report.json\"; commit C (git add -A && git commit -m \"style(rebrand): drop stale var() fallbacks\")"
  },
  {
   "step": 4,
   "what": "verify",
   "command": "npx tsc --noEmit -p tsconfig.app.json && npm run type-check && npm run build && npm test; 07-motion/verify (rec-prod.mjs + cmp.py)"
  },
  {
   "inside step 1": "0 tokens (0.0 delete global.css 50-54, 0.1 seds, 0.2 token file); 1-7 edit groups (global, shell, components, pages, code-drawn animations + 04-assets files, copy characters, tests); fmt = the repo prettier on changed files"
  }
 ],
 "schemas": {
  "01-tokens/token-map.json": "{meta, rows[], appLocal[]}; rows: old, oldValue, category, new, newValue, kind (same|renamed|value-changed|renamed+value-changed|removed), visualChange, confidence (exact|inferred), alternative?, replacement? (removed rows; for the 4 removed names still in use it equals the changes-by-file edit named in note), note, source, usesInProd, newClass?",
  "02-changes/changes-by-file.json": "{meta{baseline, step0, precedence, conventions, counts}, files[]}; file: file, component, kind, applyGroup (\"1 …\"..\"7 …\"), edits[] in apply order (bottom-up). edit: id (E001…), action (replace|insert|delete|manual|skip|token-step), selector, property, line, lineEnd?, insertAfterLine? (insert: baseline line the target goes after), lineAfterStep0 (first line of the anchor after step 0), current (exact baseline text), currentAfterStep0 (exact text after step 0 = the anchor; delete: the full lines), anchor? (insert; = currentAfterStep0), target (replace: replacement text; insert: complete line(s) with indentation; delete: \"\"; manual/skip: placeholder), replaceAll? + expectedCount?, doneByStep0, step0? (\"0.0\"|\"0.2\"), targetToken (exists in 01-tokens/rebrand-tokens.css), targetValue, changeId (-> 03-design-intent), reason, instruction? (manual), skipReason? (skip), confidence, needsOwner, visual, decided? (\"2026-11-24 <A-F>\": owner answer applied), structural? (\"owner-approved\")",
  "03-design-intent/visual-changes.json": "rows: id (G-/C-/P-), area, designName, demoComponent, element, property, before, after, figmaNode, sourceEntry, ownerDecision, superseded?, note",
  "05-coverage/coverage.json": "(a) design rows with no production counterpart; (b) production components without explicit design: token map only | needs design",
  "04-assets/assets-to-replace.json": "production asset -> rebrand asset or in-code recolour. Rows: productionPath, action, rebrandSource (relative to the design repo samgestudio-dev/Perasure), rebrandSourceInPackage (04-assets/files/… or null), colourReplacements[{from, to, token}], applyPy (\"recolour\" | \"remove\" | null: what apply.py --step 5 does), removePaths[] (remove rows), glyphCheck (Hanken row), changeId, note, usedBy[]",
  "tools/apply.py report": "{package, repo, step, dryRun, ownerItems, counts{status:n} (all rows), editCounts{status:n} (E… edits only), anchorMissing[], legacyBlueLeft[] (step 8), results[{id (E… edit | S0.0-S0.2 step 0 | A5 asset file | FMT prettier | S8 / S8T… / S8.check step 8), file, group, action, lineAfterStep0?, needsOwner?, status (applied|already-done|anchor-missing|skipped|skipped-owner), detail}]}",
  "07-motion/specs.json": "{meta{title, baseline, applyOrder[], codeRefsTree, motionPackage, tokens{}, counts{done, partial, n.a.}, statusValues{}, reference, generated}, rules[], motions[]}; rule: ruleId (R-*), text, status (respected|partial|n.a.), how, demoSource[], codeRefs[]; motion (M-001…M-139, sorted): motionId, name, area (global|component|flow), demoComponent, demoSource[] (demo file:lines), productionTarget{file, component, element}, trigger, timeline[]{property, from?, to?, unit?, transition? (token in words), tokens?{name: resolved values}, delay?, window? (part of a morph progress), note?}, delayStagger?, layout?, interruption, exit, reducedMotion, codeRefs[]{file, lines (\"a-b, c\" in the tree after motion.patch, before step 8), note?}, referenceCurve{curves, strip, video|null, variants[], status, t0, durationMs, notes} (paths under 07-motion/reference/), status (done|partial|n.a.), reason, remaining? (what is left), migrationHowTo? (how to finish), deviations[], decisionNotes[], rules[]",
  "07-motion/motion-tokens.json": "{meta, groups{<demo group>: [{name, type, params (resolved values), usedBy, source (demo file:lines), notes, production{export, definedAt (file:line in the motion-applied tree)}|null}]}}",
  "07-motion/patches/INDEX.txt": "tab-separated: patch file, status (new|modified|deleted), repo path; apply in order; together = 07-motion/motion.patch",
  "07-motion/reference/index.json": "[{motionId, name, area, demoComponent, recorded, status, curves, strip, video|null, videoNote?, durationMs, settled, loop, trigger, t0, url, syntheticTrigger, notes, takeName, variants[]}] — curves/<id>.json: {motionId, recordedWith, trigger, t0, setup, elementSelectors, settledAt, endT, events, constants, samples[{t, \"<el>.<prop>\": value}], notes}; frames/ not shipped",
  "02-changes/step8-tests.json": "{meta{what, anchor}, edits[{id (S8T…), file, test, current, target, reason}]} — exact-text test updates applied by apply.py --step 8"
 },
